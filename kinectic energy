#include iostream>
#include <iomanip>
using namespace std;

// Function to calculate kinectic energy
double kineticEnergy(double mass, double velocity) {
    return 0.5 * mass * velocity * velocity;
}
int main ()
{
    double mass, velocity;

    // Prompt user for input
    cout << "Enter mass in kilograms: ";
    cin >> mass;
    cout << "Enter velocity in meters per second: ";
    cin >> velocity;

    // Calculate kinetic energy
    double energy = kineticEnergy(mass, velocity);

    // Display the result with 2 decimal places
    cout << fixed << setprecision(2);
    cout << "The kinetic energy of the object is " << energy << " joules." << endl;

    return 0;
}